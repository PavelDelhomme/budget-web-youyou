# ============================================
# Configuration Budget Web Youyou - Production
# ============================================
# Copiez ce fichier en .env.production et configurez les valeurs

# ============================================
# SÉCURITÉ (OBLIGATOIRE)
# ============================================

# Clé secrète pour les sessions Flask (générer avec: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=votre-cle-secrete-tres-longue-et-aleatoire-minimum-64-caracteres

# Email administrateur
ADMIN_EMAIL=admin@votre-domaine.com

# Mot de passe administrateur (minimum 16 caractères, utiliser des caractères spéciaux)
ADMIN_PASSWORD=votre-mot-de-passe-tres-securise

# ============================================
# WAF (Web Application Firewall)
# ============================================

# Mode blocage WAF (true = bloque les menaces, false = log seulement)
WAF_BLOCK_MODE=true

# Nombre maximum de menaces avant blocage d'IP
WAF_MAX_THREATS_PER_IP=5

# Durée de blocage d'IP en secondes (défaut: 3600 = 1 heure)
WAF_BLOCK_DURATION=3600

# ============================================
# APPLICATION
# ============================================

# Port du backend (défaut: 6060)
PORT=6060

# Mode debug (false en production)
DEBUG=false

# Environnement Flask (production ou development)
FLASK_ENV=production

# Forcer HTTPS (true en production)
FORCE_HTTPS=true

# ============================================
# FRONTEND
# ============================================

# URL de l'API pour le frontend
VITE_API_URL=https://votre-domaine.com

# Cible du proxy Vite (développement)
VITE_PROXY_TARGET=http://backend:6060

# Désactiver HMR en production
VITE_HMR_DISABLED=true

# ============================================
# CORS (Cross-Origin Resource Sharing)
# ============================================

# Origines autorisées (séparées par des virgules)
CORS_ORIGINS=https://votre-domaine.com,https://www.votre-domaine.com

# ============================================
# NGINX (Production)
# ============================================

# Domaine de l'application
DOMAIN=votre-domaine.com

# ============================================
# SAUVEGARDES
# ============================================

# Activer les sauvegardes automatiques (true/false)
BACKUP_ENABLED=true

# Fréquence des sauvegardes (daily, weekly, monthly)
BACKUP_FREQUENCY=daily

# Nombre de jours de rétention des sauvegardes
BACKUP_RETENTION_DAYS=30

